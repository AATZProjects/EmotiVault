<!DOCTYPE html>
<html lang="en">
    <%- include('partials/header.ejs')  %>
<body>
    <main class="ev-main container-fluid">
    <h1>Browse Emoticons</h1>
    <p>Find the perfect emoticon for every mood</p>

    <!-- Filter controls -->
    <div class="ev-panel ev-filter-container">
    <form class="ev-form ev-browse-filters">
        <div class="ev-form-group">
            <label class="ev-form-label" for="search">Search:</label>
            <input 
                class="ev-input"
                type="search" 
                name="search" placeholder="Search emoticons...">
        </div>
        <div class="ev-form-group">
            <label class="ev-form-label" for="category">Category:</label>
            <select
                class="ev-select"
                name="category">
                <option>All Categories</option>
                <% for (let i = 0; i < categories.length; i++ ) { %>
                    <option value="<%= categories[i].emoticonCategory.toLowerCase() %>">
                        <%= categories[i].emoticonCategory %>
                    </option>
                <% } %>
        </select>
        </div>
        <div class="ev-form-group">
            <label class="ev-form-label" for="mood">Mood:</label>
            <select 
                class="ev-select"
                name="mood" >
                <option>All Moods</option>
                <% for (let i = 0; i < moods.length; i++ ) { %>
                    <option value="<%= moods[i].emoticonMood.toLowerCase() %>">
                        <%= moods[i].emoticonMood %>
                    </option>
                <% } %>
            </select>
        </div>
        <div class="ev-form-group">
        <label class="ev-form-label" for="mood">Sort by:</label>
            <select 
                class="ev-select"
                name="sort">
                <option value="popular">Most Popular</option>
                <option value="leastPopular">Least Popular</option>
                <option value="category">Category</option>
                <option value="mood">Mood</option>

            </select>
        </div>
        <button
            class="ev-btn ev-btn-primary"
            type="submit">Search</button>
    </form>
</div>

    <!-- Table -->
    <div class="ev-table-container">
        <div class="ev-table-scroll">
            <table class="ev-table">
                <thead>
                    <tr>
                    <th>Emoticon</th>
                    <th>Category</th>
                    <th>Mood</th>
                    <th>Favorites</th>
                    <th class="ev-table-actions">Actions</th>
                    </tr>
                </thead>
                <tbody id="emoticon-result">
                    <% for (let i = 0; i < emoticons.length; i++) { %>
                            
                        <tr>
                        <td class="ev-table-emoticon"><%=emoticons[i].emoticonString%></td>
                        <td><%=emoticons[i].emoticonCategory%></td>
                        <td><%=emoticons[i].emoticonMood%></td>
                        <td><%=emoticons[i].favorites %></td>
                        <td class="ev-table-actions">
                        <button class="ev-btn ev-btn-light ev-btn-sm copyBtns" 
                                data-emoticon="<%=emoticons[i].emoticonString%>">
                        Copy
                        </button>

                        <button
                            type="button"
                            class="ev-icon-button starBtns"
                            data-emoticonId="<%=emoticons[i].emoticonId%>" 
                            >
                            ☆
                        </button>
                        </td>
                        </tr>
                        <% } %>

                
                </tbody>
            </table>
    </div>

    <!-- Updates the visibility of the page navigation buttons-->
    <nav class="ev-pagination" id="paginationBar">
        <% if (currentPage == 1) {%>
            <a class="ev-page-link is-disabled firstBtn" href="/browse?page=1">
            ‹‹ First
            </a>
        <% } else { %>
            <a class="ev-page-link firstBtn" href="/browse?page=1">
            ‹‹ First
            </a>
        <% } %>

        <% if (currentPage > 1) { %>
            <a class="ev-page-link prevBtn" href="/browse?page=<%=currentPage - 1%>">
            ‹ Prev
            </a>
        <% } else { %>
            <a class="ev-page-link is-disabled prevBtn" href="/browse?page=<%=currentPage - 1 %>">
            ‹ Prev
            </a>
        <% } %>

         <!-- highlights the currenly active page  -->
        <% if (currentPage == 1) { %>
            <a class="ev-page-link is-active ev-page-number" href="/browse?page=1" data-page="1">
            1
            </a>
        <% } else { %>
            <a class="ev-page-link ev-page-number" href="/browse?page=1" data-page="1">
            1
            </a>
        <% } %>

        <% if (currentPage == 2) { %>
            <a class="ev-page-link is-active ev-page-number" href="/browse?page=2" data-page="2">2</a>
        <% } else { %>
            <a class="ev-page-link ev-page-number" href="/browse?page=2" data-page="2">2</a>
        <% } %>

        <% if (currentPage == 3) { %>
            <a class="ev-page-link is-active" href="/browse?page=3" data-page="3">3</a>
        <% } else { %>
            <a class="ev-page-link ev-page-number" href="/browse?page=3" data-page="3">3</a>
        <% } %>

        <% if (currentPage == 4) { %>
            <a class="ev-page-link is-active ev-page-number" href="/browse?page=4" data-page="4">4</a>
        <% } else { %>
            <a class="ev-page-link ev-page-number" href="/browse?page=4" data-page="4">4</a>
        <% } %>

        <a class="ev-page-ellipsis">...</a>  

        <% if (currentPage == 28) { %>
            <a class="ev-page-link is-active ev-page-number" href="/browse?page=28" data-page="28">28</a>
            <% } else { %>
            <a class="ev-page-link ev-page-number" href="/browse?page=28" data-page="28">28</a>
        <% } %>

        <% if (currentPage == 28) { %>
            <a class="ev-page-link is-disabled nextBtn" href="/browse?page=<%=currentPage + 1 %>">Next ›</a>
        <% } else { %>
            <a class="ev-page-link nextBtn" href="/browse?page=<%=currentPage + 1 %>">Next ›</a>
        <% } %>

        <% if (currentPage == 28) { %>
            <a class="ev-page-link is-disabled lastBtn" href="/browse?page=28 %>">
            Last ››
            </a>
        <% } else { %>
            <a class="ev-page-link lastBtn" href="/browse?page=28">Last ››</a>
        <% } %>


    </nav>
    </div>
    <section>
        <div class="ev-panel browse-help-card">
            <div class="ev-panel-body">
                <div class="browse-help-content">
                    <img src="imgs/emotivault_aim_buddy.svg" alt="emoticon icon" class="browse-help-image">
                    <div>
                        <h3>Make it Uniquely you!</h3>  
                        <p>Explore thousands of classic emoticons <br>
                            and find the ones that speak to you.</p>
                        <img src="imgs/emotivault_icon_heart.svg" alt="heart decor" class="pixelHeart">
                    </div>
                </div>
            </div>
            <div class="browse-help-tips">
                <h3>Tips:</h3>
                <ul>
                    <li>Filter by category or mood to find what you need</li>
                    <li>Add favorites to quick access your top picks</li>
                </ul>
            </div>

            <div class="decorArt">
                <img src="imgs/emotivault_computer_buddy.svg" alt="computer decor" class="pixelComputer">
                <img src="imgs/emotivault_icon_rainbow.svg" alt="rainbow decor" class="pixelRainbow">
            </div>
        </div>
    </section>
    </main>
    <%- include('partials/footer')  %>
    <script src="/js/browse.js"></script>
</body>
</html>