<%- include("partials/header.ejs") %>

  <main class="container ev-main">
    <header class="mb-4">
      <h1 class="ev-page-title">EmotiVault Style Guide</h1>
    </header>

    <!-- =====================================================
       VISUAL STANDARDS
       ===================================================== -->

    <section class="ev-window mb-4">
      <div class="ev-window-titlebar">
        <span class="ev-window-title">Visual Standards</span>

        <div class="ev-window-controls" aria-hidden="true">
          <span class="ev-window-control">—</span>
          <span class="ev-window-control">□</span>
          <span class="ev-window-control ev-window-control--close">×</span>
        </div>
      </div>

      <div class="ev-window-body">
        <h2 class="ev-section-title">Color Palette</h2>

        <div class="row g-3 mb-4">
          <div class="col-6 col-md-4 col-lg-2">
            <div class="ev-token-card">
              <div class="ev-color-swatch ev-color-primary"></div>
              <strong>Primary Blue</strong>
              <code>--ev-blue</code>
              <code>#0038A6</code>
            </div>
          </div>

          <div class="col-6 col-md-4 col-lg-2">
            <div class="ev-token-card">
              <div class="ev-color-swatch ev-color-blue-light"></div>
              <strong>Light Blue</strong>
              <code>--ev-blue-light</code>
              <code>#4F8BFF</code>
            </div>
          </div>

          <div class="col-6 col-md-4 col-lg-2">
            <div class="ev-token-card">
              <div class="ev-color-swatch ev-color-purple"></div>
              <strong>Purple</strong>
              <code>--ev-purple</code>
              <code>#A547D6</code>
            </div>
          </div>

          <div class="col-6 col-md-4 col-lg-2">
            <div class="ev-token-card">
              <div class="ev-color-swatch ev-color-yellow"></div>
              <strong>Yellow</strong>
              <code>--ev-yellow</code>
              <code>#FFCC00</code>
            </div>
          </div>

          <div class="col-6 col-md-4 col-lg-2">
            <div class="ev-token-card">
              <div class="ev-color-swatch ev-color-green"></div>
              <strong>Green</strong>
              <code>--ev-green</code>
              <code>#00A650</code>
            </div>
          </div>

          <div class="col-6 col-md-4 col-lg-2">
            <div class="ev-token-card">
              <div class="ev-color-swatch ev-color-red"></div>
              <strong>Red</strong>
              <code>--ev-red</code>
              <code>#D9463E</code>
            </div>
          </div>
        </div>

        <h2 class="ev-section-title mt-4">Typography</h2>

        <article class="ev-panel mb-4">
          <div class="ev-panel-header">Preview</div>

          <div class="ev-panel-body">
            <h1 class="mb-3">Heading One</h1>
            <h2 class="mb-3">Heading Two</h2>
            <h3 class="mb-3">Heading Three</h3>

            <p class="mb-2">
              Standard body text uses Tahoma, Verdana, or MS Sans Serif.
            </p>

            <p class="ev-muted mb-2">
              Muted text is used for secondary information and descriptions.
            </p>

            <p class="ev-font-monospace fs-4 mb-0">¯\_(ツ)_/¯</p>
          </div>
        </article>

        <h2 class="ev-section-title">HTML</h2>

        <pre class="ev-code-block"><code>&lt;h1&gt;Heading One&lt;/h1&gt;

&lt;h2&gt;Heading Two&lt;/h2&gt;

&lt;h3&gt;Heading Three&lt;/h3&gt;

&lt;p&gt;
  Standard body text
&lt;/p&gt;

&lt;p class="ev-muted"&gt;
  Muted supporting text
&lt;/p&gt;

&lt;p class="ev-font-monospace"&gt;
  ¯\_(ツ)_/¯
&lt;/p&gt;</code></pre>

        <div class="ev-usage-notes">
          <h3>Usage notes</h3>

          <ul class="mb-0">
            <li>Use one <code>h1</code> for the main page title.</li>
            <li>Use <code>h2</code> for major sections.</li>
            <li>Use <code>h3</code> for smaller subsections.</li>
            <li>Use <code>ev-muted</code> for secondary text.</li>
            <li>
              Use <code>ev-font-monospace</code> when displaying emoticons whose
              spacing matters.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- =====================================================
       CONTAINERS
       ===================================================== -->

    <section class="ev-window mb-4">
      <div class="ev-window-titlebar">
        <span class="ev-window-title">Containers</span>

        <div class="ev-window-controls" aria-hidden="true">
          <span class="ev-window-control">—</span>
          <span class="ev-window-control">□</span>
          <span class="ev-window-control ev-window-control--close">×</span>
        </div>
      </div>

      <div class="ev-window-body">
        The main container is the one this content is in. It has the EmotiVault
        blue title bar and the window control icons in the corner.
        <h2 class="ev-section-title mt-4">HTML</h2>

        <pre class="ev-code-block"><code>&lt;main class="ev-main container-fluid"&gt;
  &lt;div class="ev-window"&gt;

    &lt;div class="ev-window-titlebar"&gt;
      &lt;span class="ev-window-title"&gt;
        Window Title Goes Here
      &lt;/span&gt;

      &lt;div class="ev-window-controls" aria-hidden="true"&gt;
        &lt;span class="ev-window-control"&gt;—&lt;/span&gt;
        &lt;span class="ev-window-control"&gt;□&lt;/span&gt;
        &lt;span class="ev-window-control ev-window-control--close"&gt;×&lt;/span&gt;
      &lt;/div&gt;
    &lt;/div&gt;

    &lt;div class="ev-window-body"&gt;
      Body Content Goes Here
    &lt;/div&gt;

  &lt;/div&gt;
&lt;/main&gt;</code></pre>

        <div class="row g-4 mt-4">
          <div class="col-md-6">
            <article class="ev-panel h-100">
              <div class="ev-panel-header">Standard Panel</div>

              <div class="ev-panel-body">
                <p class="mb-0">
                  Use this container for filters, forms, account information, and
                  regular page content.
                </p>
              </div>
            </article>
          </div>

          <div class="col-md-6">
            <article class="ev-panel h-100">
              <div class="ev-panel-header ev-panel-header--purple">
                Featured Panel
              </div>

              <div class="ev-panel-body ev-bg-warm">
                <p class="mb-0">
                  Use this variation for featured content such as Emoticon of the
                  Day.
                </p>
              </div>
            </article>
          </div>
        </div>

        <h2 class="ev-section-title mt-4">HTML</h2>

        <pre class="ev-code-block"><code>&lt;div class="ev-panel"&gt;
  &lt;div class="ev-panel-header"&gt;
    Standard Panel
  &lt;/div&gt;

  &lt;div class="ev-panel-body"&gt;
    Use this container for filters, forms, account information, and regular page content.
  &lt;/div&gt;
&lt;/div&gt;</code></pre>

        <div class="ev-usage-notes">
          <h3>Usage notes</h3>

          <ul class="mb-0">
            <li>
              Use <code>ev-panel</code> inside windows to group related content.
            </li>
            <li>
              Add <code>ev-panel-header--purple</code> only to featured panels.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- =====================================================
       BUTTONS
       ===================================================== -->

    <section class="ev-window mb-4">
      <div class="ev-window-titlebar">
        <span class="ev-window-title">Buttons</span>

        <div class="ev-window-controls" aria-hidden="true">
          <span class="ev-window-control">—</span>
          <span class="ev-window-control">□</span>
          <span class="ev-window-control ev-window-control--close">×</span>
        </div>
      </div>

      <div class="ev-window-body">
        <h2 class="ev-section-title">Preview</h2>

        <div class="d-flex flex-wrap gap-2 ev-button-row">
          <button type="button" class="ev-btn ev-btn-primary">Primary</button>

          <button type="button" class="ev-btn ev-btn-secondary">Secondary</button>

          <button type="button" class="ev-btn ev-btn-success">Success</button>

          <button type="button" class="ev-btn ev-btn-danger">Danger</button>

          <button type="button" class="ev-btn ev-btn-warning">Warning</button>

          <button type="button" class="ev-btn ev-btn-light">Light</button>

          <button type="button" class="ev-btn ev-btn-outline">Outline</button>

          <button type="button" class="ev-btn ev-btn-primary" disabled>
            Disabled
          </button>
        </div>

        <h2 class="ev-section-title mt-4">HTML</h2>

        <pre class="ev-code-block"><code>&lt;button type="button" class="ev-btn ev-btn-primary"&gt;
  Primary
&lt;/button&gt;

&lt;button type="button" class="ev-btn ev-btn-secondary"&gt;
  Secondary
&lt;/button&gt;

&lt;button type="button" class="ev-btn ev-btn-danger"&gt;
  Delete
&lt;/button&gt;</code></pre>

        <div class="ev-usage-notes">
          <h3>Usage notes</h3>

          <ul class="mb-0">
            <li>Use Primary for the main action on a page or form.</li>
            <li>Use Secondary for a supporting action.</li>
            <li>Use Success after a successful operation.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- =====================================================
       MOOD BADGES
       ===================================================== -->

    <section class="ev-window mb-4">
      <div class="ev-window-titlebar ev-window-titlebar--purple">
        <span class="ev-window-title">Mood Badges</span>

        <div class="ev-window-controls" aria-hidden="true">
          <span class="ev-window-control">—</span>
          <span class="ev-window-control">□</span>
          <span class="ev-window-control ev-window-control--close">×</span>
        </div>
      </div>

      <div class="ev-window-body">
        <h2 class="ev-section-title">Preview</h2>

        <div class="d-flex flex-wrap gap-2">
          <span class="ev-mood-badge ev-mood-happy">Happy</span>
          <span class="ev-mood-badge ev-mood-sad">Sad</span>
          <span class="ev-mood-badge ev-mood-angry">Angry</span>
          <span class="ev-mood-badge ev-mood-love">Love</span>
          <span class="ev-mood-badge ev-mood-surprised">Surprised</span>
          <span class="ev-mood-badge ev-mood-confused">Confused</span>
          <span class="ev-mood-badge ev-mood-embarrassed"> Embarrassed </span>
          <span class="ev-mood-badge ev-mood-playful">Playful</span>
          <span class="ev-mood-badge ev-mood-neutral">Neutral</span>
          <span class="ev-mood-badge ev-mood-sleepy">Sleepy</span>
          <span class="ev-mood-badge ev-mood-cool">Cool</span>
          <span class="ev-mood-badge ev-mood-respect">Respect</span>
        </div>

        <h2 class="ev-section-title mt-4">HTML</h2>

        <pre class="ev-code-block"><code>&lt;span class="ev-mood-badge ev-mood-happy"&gt;
  Happy
&lt;/span&gt;

&lt;span class="ev-mood-badge ev-mood-angry"&gt;
  Angry
&lt;/span&gt;

&lt;span class="ev-mood-badge ev-mood-respect"&gt;
  Respect
&lt;/span&gt;</code></pre>

        <div class="ev-usage-notes">
          <h3>Usage notes</h3>

          <ul class="mb-0">
            <li>Always include the base class <code>ev-mood-badge</code>.</li>
            <li>
              Add exactly one mood class, such as <code>ev-mood-happy</code>.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- =====================================================
     FORMS
     ===================================================== -->

    <section class="ev-window mb-4">
      <div class="ev-window-titlebar">
        <span class="ev-window-title">Forms</span>

        <div class="ev-window-controls" aria-hidden="true">
          <span class="ev-window-control">—</span>
          <span class="ev-window-control">□</span>
          <span class="ev-window-control ev-window-control--close">×</span>
        </div>
      </div>

      <div class="ev-window-body">
        <h2 class="ev-section-title">Preview</h2>

        <div class="row g-4">
          <!-- Standard form -->

          <div class="col-lg-6">
            <article class="ev-panel h-100">
              <div class="ev-panel-header">Standard Form</div>

              <div class="ev-panel-body">
                <form class="ev-form" action="#" method="post">
                  <div class="ev-form-group">
                    <label class="ev-form-label" for="example-username">
                      Username
                      <span class="ev-form-required">*</span>
                    </label>

                    <input id="example-username" class="ev-input" type="text" name="username"
                      placeholder="Enter a username" required />

                    <span class="ev-form-help">
                      Your username must be unique.
                    </span>
                  </div>

                  <div class="ev-form-group">
                    <label class="ev-form-label" for="example-password">
                      Password
                      <span class="ev-form-required">*</span>
                    </label>

                    <input id="example-password" class="ev-input" type="password" name="password"
                      placeholder="Enter a password" required />
                  </div>

                  <div class="ev-form-group">
                    <label class="ev-form-label" for="example-mood"> Mood </label>

                    <select id="example-mood" class="ev-select" name="mood">
                      <option value="">Select a mood</option>
                      <option value="Happy">Happy</option>
                      <option value="Sad">Sad</option>
                      <option value="Angry">Angry</option>
                      <option value="Love">Love</option>
                      <option value="Surprised">Surprised</option>
                      <option value="Confused">Confused</option>
                      <option value="Embarrassed">Embarrassed</option>
                      <option value="Playful">Playful</option>
                      <option value="Neutral">Neutral</option>
                      <option value="Sleepy">Sleepy</option>
                      <option value="Cool">Cool</option>
                      <option value="Respect">Respect</option>
                    </select>
                  </div>

                  <div class="ev-form-group">
                    <label class="ev-form-label" for="example-description">
                      Description
                    </label>

                    <textarea id="example-description" class="ev-textarea" name="description"
                      placeholder="Enter a description"></textarea>
                  </div>

                  <div class="ev-check-group">
                    <label class="ev-check">
                      <input class="ev-check-input" type="checkbox" name="favorite" />
                      Add to favorites
                    </label>

                    <label class="ev-check">
                      <input class="ev-check-input" type="checkbox" name="public" />
                      Make public
                    </label>
                  </div>

                  <div class="ev-form-actions">
                    <button type="submit" class="ev-btn ev-btn-primary">
                      Submit
                    </button>

                    <button type="reset" class="ev-btn ev-btn-light">
                      Reset
                    </button>
                  </div>
                </form>
              </div>
            </article>
          </div>

          <!-- Form states -->

          <div class="col-lg-6">
            <article class="ev-panel h-100">
              <div class="ev-panel-header ev-panel-header--purple">
                Form States
              </div>

              <div class="ev-panel-body">
                <div class="ev-form-group">
                  <label class="ev-form-label" for="invalid-username">
                    Invalid Input
                  </label>

                  <input id="invalid-username" class="ev-input is-invalid" type="text" value="admin"
                    aria-describedby="username-error" aria-invalid="true" />

                  <span id="username-error" class="ev-form-error">
                    This username is already in use.
                  </span>
                </div>

                <div class="ev-form-group">
                  <label class="ev-form-label" for="disabled-input">
                    Disabled Input
                  </label>

                  <input id="disabled-input" class="ev-input" type="text" value="This field cannot be edited"
                    disabled />
                </div>

                <div class="ev-form-group">
                  <label class="ev-form-label" for="disabled-select">
                    Disabled Select
                  </label>

                  <select id="disabled-select" class="ev-select" disabled>
                    <option>Classic</option>
                  </select>
                </div>
              </div>
            </article>
          </div>
        </div>

        <h2 class="ev-section-title mt-4">HTML</h2>

        <pre class="ev-code-block"><code>&lt;form class="ev-form"&gt;
  &lt;div class="ev-form-group"&gt;
    &lt;label class="ev-form-label" for="username"&gt;
      Username
      &lt;span class="ev-form-required"&gt;*&lt;/span&gt;
    &lt;/label&gt;

    &lt;input
      id="username"
      class="ev-input"
      type="text"
      name="username"
      placeholder="Enter a username"
      required
    /&gt;

    &lt;span class="ev-form-help"&gt;
      Your username must be unique.
    &lt;/span&gt;
  &lt;/div&gt;

  &lt;div class="ev-form-group"&gt;
    &lt;label class="ev-form-label" for="mood"&gt;
      Mood
    &lt;/label&gt;

    &lt;select id="mood" class="ev-select" name="mood"&gt;
      &lt;option value=""&gt;Select a mood&lt;/option&gt;
      &lt;option value="Happy"&gt;Happy&lt;/option&gt;
      &lt;option value="Sad"&gt;Sad&lt;/option&gt;
    &lt;/select&gt;
  &lt;/div&gt;

  &lt;div class="ev-form-actions"&gt;
    &lt;button class="ev-btn ev-btn-primary" type="submit"&gt;
      Submit
    &lt;/button&gt;
  &lt;/div&gt;
&lt;/form&gt;</code></pre>

        <div class="ev-usage-notes">
          <h3>Usage notes</h3>

          <ul class="mb-0">
            <li>
              Use <code>ev-input</code> for text, password, email, number, and
              search fields.
            </li>

            <li>Use <code>ev-select</code> for dropdown menus.</li>

            <li>Use <code>ev-textarea</code> for longer text.</li>

            <li>Use <code>ev-form-help</code> for optional instructions.</li>

            <li>
              Add <code>is-invalid</code> and <code>ev-form-error</code> when
              validation fails.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- =====================================================
     SEARCH & FILTER FORM
     ===================================================== -->

    <section class="ev-window mb-4">
      <div class="ev-window-titlebar">
        <span class="ev-window-title">Search & Filter Forms</span>

        <div class="ev-window-controls" aria-hidden="true">
          <span class="ev-window-control">—</span>
          <span class="ev-window-control">□</span>
          <span class="ev-window-control ev-window-control--close">×</span>
        </div>
      </div>

      <div class="ev-window-body">
        <h2 class="ev-section-title">Preview</h2>

        <form action="#" method="get">
          <div class="row g-3 align-items-end">
            <div class="col-lg-5">
              <label class="ev-form-label" for="search"> Search </label>

              <input id="search" class="ev-input" type="search" placeholder="Search emoticons..." />
            </div>

            <div class="col-md-4 col-lg-3">
              <label class="ev-form-label" for="category"> Category </label>

              <select id="category" class="ev-select">
                <option>All Categories</option>
                <option>Classic</option>
                <option>Upright</option>
                <option>Unicode</option>
                <option>Kaomoji</option>
                <option>Misc</option>
                <option>2Channel</option>
              </select>
            </div>

            <div class="col-md-4 col-lg-2">
              <label class="ev-form-label" for="mood"> Mood </label>

              <select id="mood" class="ev-select">
                <option>All Moods</option>
                <option>Happy</option>
                <option>Sad</option>
                <option>Angry</option>
                <option>Love</option>
              </select>
            </div>

            <div class="col-md-4 col-lg-2">
              <button class="ev-btn ev-btn-primary w-100" type="submit">
                Search
              </button>
            </div>
          </div>
        </form>

        <h2 class="ev-section-title mt-4">HTML</h2>

        <pre class="ev-code-block"><code>&lt;form&gt;

  &lt;input
      class="ev-input"
      type="search"
      name="search"
      placeholder="Search..."
  &gt;

  &lt;select
      class="ev-select"
      name="category"&gt;

      &lt;option&gt;Classic&lt;/option&gt;

  &lt;/select&gt;

  &lt;select
      class="ev-select"
      name="mood"&gt;

      &lt;option&gt;Happy&lt;/option&gt;

  &lt;/select&gt;

  &lt;button
      class="ev-btn ev-btn-primary"
      type="submit"&gt;

      Search

  &lt;/button&gt;

&lt;/form&gt;</code></pre>

        <div class="ev-usage-notes">
          <h3>Usage Notes</h3>

          <ul class="mb-0">
            <li>Use <code>ev-input</code> for text and search fields.</li>

            <li>Use <code>ev-select</code> for dropdown filters.</li>

            <li>Keep the Search button aligned with the inputs.</li>
          </ul>
        </div>
      </div>
    </section>

