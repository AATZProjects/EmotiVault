<%- include("partials/header", { pageTitle: "AIM Away Message Generator" , currentPage: "aim-status" }) %>

  <main class="ev-main container-fluid">
    <div class="ev-window">
      <div class="ev-window-titlebar">
        <span class="ev-window-title">AIM Away Message Generator</span>
        <div class="ev-window-controls" aria-hidden="true">
          <span class="ev-window-control">—</span>
          <span class="ev-window-control">□</span>
          <span class="ev-window-control ev-window-control--close">×</span>
        </div>
      </div>

      <div class="ev-window-body aim-generator-body">
        <div class="row g-4">

          <!-- Left-side form -->
          <section class="col-lg-7">
            <form class="ev-form aim-generator-form" id="aimStatusForm">
              <!-- Step 1 -->
              <fieldset class="aim-form-step">
                <legend class="aim-step-title">
                  1. Enter a song and artist
                </legend>

                <div class="aim-song-entry">
                  <div class="aim-song-fields">

                    <div class="aim-input-wrapper">
                      <label class="aim-icon-input" for="songTitle">
                        <input id="songTitle" class="ev-input aim-text-input" type="text" name="songTitle"
                          placeholder="Enter a song title" autocomplete="off" aria-describedby="songTitleError"
                          required />
                      </label>

                      <span id="songTitleError" class="ev-form-error" hidden></span>
                    </div>

                    <div class="aim-input-wrapper">
                      <label class="aim-icon-input" for="artistName">
                        <input id="artistName" class="ev-input aim-text-input" type="text" name="artistName"
                          placeholder="Enter an artist" autocomplete="off" aria-describedby="artistNameError"
                          required />
                      </label>

                      <span id="artistNameError" class="ev-form-error" hidden></span>
                    </div>

                  </div>

                  <button class="ev-btn ev-btn-primary aim-lyrics-button" type="button" id="getLyricsButton">
                    ♫ Get Lyrics
                  </button>
                </div>
              </fieldset>

              <!-- Step 2 -->
              <fieldset class="aim-form-step">
                <legend class="aim-step-title">
                  2. Choose a generated lyric
                </legend>

                <div class="aim-lyric-list" id="generatedLyrics" role="radiogroup" aria-label="Generated lyrics">
                  <p class="ev-muted aim-lyrics-message">Enter a song and artist to get lyrics...</p>
                </div>
              </fieldset>

              <!-- Step 3 -->
              <fieldset class="aim-form-step aim-mood-section">
                <legend class="aim-step-title">
                  3. Select a mood
                </legend>

                <div class="aim-mood-grid" id="moodOptions" role="radiogroup" aria-label="Select a mood">
                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Happy" checked />
                    <span class="aim-mood-icon" aria-hidden="true">🙂</span>
                    <span class="aim-mood-name">Happy</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Sad" />
                    <span class="aim-mood-icon" aria-hidden="true">☹️</span>
                    <span class="aim-mood-name">Sad</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Angry" />
                    <span class="aim-mood-icon" aria-hidden="true">😡</span>
                    <span class="aim-mood-name">Angry</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Love" />
                    <span class="aim-mood-icon" aria-hidden="true">❤️</span>
                    <span class="aim-mood-name">Love</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Surprised" />
                    <span class="aim-mood-icon" aria-hidden="true">😮</span>
                    <span class="aim-mood-name">Surprised</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Confused" />
                    <span class="aim-mood-icon" aria-hidden="true">😕</span>
                    <span class="aim-mood-name">Confused</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Embarrassed" />
                    <span class="aim-mood-icon" aria-hidden="true">😳</span>
                    <span class="aim-mood-name">Embarrassed</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Playful" />
                    <span class="aim-mood-icon" aria-hidden="true">😜</span>
                    <span class="aim-mood-name">Playful</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Neutral" />
                    <span class="aim-mood-icon" aria-hidden="true">😐</span>
                    <span class="aim-mood-name">Neutral</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Sleepy" />
                    <span class="aim-mood-icon" aria-hidden="true">😴</span>
                    <span class="aim-mood-name">Sleepy</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Cool" />
                    <span class="aim-mood-icon" aria-hidden="true">😎</span>
                    <span class="aim-mood-name">Cool</span>
                  </label>

                  <label class="aim-mood-card">
                    <input type="radio" name="mood" value="Respect" />
                    <span class="aim-mood-icon" aria-hidden="true">🫡</span>
                    <span class="aim-mood-name">Respect</span>
                  </label>
                </div>
              </fieldset>

            </form>
          </section>

          <!-- Right-side preview -->
          <section class="col-lg-5">
            <div class="ev-panel aim-preview-panel">
              <div class="ev-panel-header">Your Away Message</div>

              <div class="ev-panel-body aim-preview-body">

                <!-- Username -->
                <div class="aim-preview-section">
                  <h6 class="aim-preview-heading">Username:</h6>

                  <div class="aim-preview-username">
                    <span class="aim-preview-sparkle" aria-hidden="true">✦</span>

                    <span id="previewUsername">
                      <% if (locals.session && locals.session.authenticated) { %>
                        <%= session.name %>
                          <% } else { %>
                            xxLonelyPixelXx
                            <% } %>
                    </span>

                    <span class="aim-preview-sparkle" aria-hidden="true">✦</span>
                  </div>
                </div>

                <hr class="aim-preview-divider">

                <!-- Away message -->
                <div class="aim-preview-section">
                  <h6 class="aim-preview-heading">Away Message:</h6>

                  <div class="aim-away-box">
                    <p id="previewLyric"></p>
                    <p id="previewEmoticon"></p>
                  </div>
                </div>

                <!-- Listening to -->
                <div class="aim-preview-section aim-listening-section">
                  <h6 class="aim-preview-heading">Listening to:</h6>

                  <div class="aim-listening">
                    <span id="previewArtist"></span>
                    <span class="aim-listening-note" aria-hidden="true">♫</span>
                  </div>
                </div>

              </div>
            </div>
          </section>

        </div>
      </div>
    </div>
  </main>

  <script src="/js/aim-status-generator.js"></script>
  <%- include("partials/footer") %>
