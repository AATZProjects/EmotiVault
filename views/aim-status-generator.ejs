<%- include("partials/header", {
  pageTitle: "AIM Away Message Generator",
  currentPage: "aim-status"
}) %>

<main class="ev-main container-fluid">
<div class="ev-window">
  <div class="ev-window-titlebar">
    <span class="ev-window-title">AIM Away Message Generator</span>
    <div class="ev-window-controls" aria-hidden="true">
      <span class="ev-window-control">—</span>
      <span class="ev-window-control">□</span>
      <span class="ev-window-control ev-window-control--close">×</span>
