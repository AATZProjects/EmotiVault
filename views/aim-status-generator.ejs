  </div>

  <div class="ev-window-body">
    <div class="row">
      <section class="col-lg-7">
        Left side
      </section>
      <section class="col-lg-5">
        <div class="ev-panel">
        <div class="ev-panel-header">Preview</div>
        <div class="ev-panel-body">
        right side content
      </div>
      </section>
    </div>
  </div>
</div>
</div>
</main>

<%- include("partials/footer") %>
