<nav class="main-nav" aria-label="Primary navigation">
  <a class="nav-brand" href="/">
    <img src="/imgs/emotivault_logo.svg" alt="EmotiVault" class="nav-logo" />
  </a>

  <div class="nav-links">
    <a
      class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'home' ? 'active' : '' %>"
      href="/"
    >
      <img src="/imgs/emotivault_icon_home.svg" alt="" class="nav-icon" />
      <span>Home</span>
    </a>

    <a
      class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'browse' ? 'active' : '' %>"
      href="/browse"
    >
      <img src="/imgs/emotivault_icon_browse.svg" alt="" class="nav-icon" />
      <span>Browse</span>
    </a>

    <a
      class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'aim-status' ? 'active' : '' %>"
      href="/aim-status-generator"
    >
      <img src="/imgs/emotivault_aim_buddy.svg" alt="" class="nav-icon" />
      <span>AIM Status</span>
    </a>

    <a
      class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'favorites' ? 'active' : '' %>"
      href="/favorites"
    >
      <img src="/imgs/emotivault_icon_favorites.svg" alt="" class="nav-icon" />
      <span>Favorites</span>
    </a>

    <!-- Auth State: Login / Logout -->
    <% if (locals.session && locals.session.authenticated) { %>
      <span class="nav-item text-success fw-bold">
        <span><%= session.name %></span>
      </span>
      <a class="nav-item text-danger" href="/logout">
        <span>Logout</span>
      </a>
    <% } else { %>
      <a
        class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'login' ? 'active' : '' %>"
        href="/login"
      >
        <span>Login</span>
      </a>
    <% } %>
  </div>
</nav>