<nav class="main-nav" aria-label="Primary navigation">
  <a class="nav-brand" href="/">
    <img src="/imgs/emotivault_logo.svg" alt="EmotiVault" class="nav-logo" />
  </a>

  <div class="nav-links">
    <a class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'home' ? 'active' : '' %>" href="/">
      <img src="/imgs/emotivault_icon_home.svg" alt="" class="nav-icon" />
      <span>Home</span>
    </a>

    <a class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'browse' ? 'active' : '' %>"
      href="/browse">
      <img src="/imgs/emotivault_icon_browse.svg" alt="" class="nav-icon" />
      <span>Browse</span>
    </a>

    <a class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'aim-status' ? 'active' : '' %>"
      href="/aim-status-generator">
      <img src="/imgs/emotivault_aim_buddy.svg" alt="" class="nav-icon" />
      <span>AIM Status</span>
    </a>

    <a class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'favorites' ? 'active' : '' %>"
      href="/favorites">
      <img src="/imgs/emotivault_icon_favorites.svg" alt="" class="nav-icon" />
      <span>Favorites</span>
    </a>

    <!-- Admin Navigation -->
    <% if ( locals.session && locals.session.authenticated && locals.session.isAdmin ) { %>
      <a class="nav-item <%= typeof currentPage !== 'undefined' && currentPage === 'admin' ? 'active' : '' %>"
        href="/admin/emoticons">
        <img src="/imgs/emotivault_icon_admin.svg" alt="" class="nav-icon" />
        <span>Admin</span>
      </a>
      <% } %>

        <!-- Auth State: Login / Logout -->
        <div class="nav-account">
          <% if (locals.session && locals.session.authenticated) { %>

            <div class="nav-user">
              <img src="/imgs/emotivault_user.svg" alt="" class="nav-user-icon" />
              <span>
                <%= session.name %>
              </span>
            </div>

            <a class="nav-logout" href="/logout">
              Logout
            </a>

            <% } else { %>

              <a class="nav-login <%= typeof currentPage !== 'undefined' && currentPage === 'login' ? 'active' : '' %>"
                href="/login">
                <img src="/imgs/emotivault_user.svg" alt="" class="nav-user-icon" />
                <span>Login</span>
              </a>

              <% } %>
        </div>
  </div>
</nav>
